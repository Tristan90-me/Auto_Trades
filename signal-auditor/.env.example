# Copy this file to .env and fill it in. Never share .env with anyone.

# From https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# The signal channel: @username, t.me link, numeric id, or its exact name
CHANNEL=

# Optional. Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Simulation assumptions (match what Quotex pays you)
STAKE=1
PAYOUT=0.85
GALE_MULTIPLIER=2
DEFAULT_EXPIRY_MIN=5

# Channel's clock as a UTC offset (e.g. -3). Leave blank to auto-detect.
SIGNAL_UTC_OFFSET=

# When to send the daily report, in UTC
REPORT_TIME_UTC=22:00
